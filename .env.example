# Copy to .env and adjust. Every value is optional; defaults are shown.
# Never put the database password here: use the sidebar, ANALYST_DB_PASSWORD_FILE
# (Docker/Kubernetes secrets) or the server's secret manager.

# --- Ollama ---
ANALYST_OLLAMA_URL=http://localhost:11434/api/generate
ANALYST_MODEL=qwen2.5:3b
ANALYST_NUM_CTX=8192
ANALYST_KEEP_ALIVE=30m
ANALYST_SQL_READ_TIMEOUT_S=180
ANALYST_EXPLAIN_READ_TIMEOUT_S=180
ANALYST_SQL_MAX_TOKENS=600
ANALYST_EXPLAIN_MAX_TOKENS=300

# --- Business profile: teaches the analyst your data (see docs/DOMAINS.md) ---
# Empty = generic mode (works from the live schema alone).
# Demo/retail database: config/domain.retail.yaml. Your own: copy config/domain.example.yaml.
ANALYST_DOMAIN_FILE=
# Extra attempts the model gets to fix a query that failed validation or MySQL (0-3)
ANALYST_SQL_RETRIES=1

# --- MySQL (use a SELECT-only account) ---
ANALYST_DB_HOST=127.0.0.1
ANALYST_DB_PORT=3306
ANALYST_DB_NAME=retail_analytics
ANALYST_DB_USER=analyst_readonly
# Path to a CA bundle: enforces TLS and verifies the server certificate.
# ANALYST_DB_SSL_CA=/etc/ssl/certs/mysql-ca.pem
# Server-side password (optional; hides the sidebar field). Prefer the file form:
# ANALYST_DB_PASSWORD_FILE=/run/secrets/analyst_db_password

# --- Query limits ---
ANALYST_MAX_ROWS=500
ANALYST_QUERY_TIMEOUT_MS=10000
ANALYST_MAX_QUERIES_PER_MINUTE=20

# --- Authentication ---
# local = users file (manage with: python -m ai_database_analyst users add NAME)
# proxy = trust a header set by your SSO reverse proxy (see docs/DEPLOYMENT.md)
# none  = no login; local development only
ANALYST_AUTH_MODE=local
ANALYST_USERS_FILE=data/users.json
ANALYST_PROXY_USER_HEADER=X-Forwarded-User
ANALYST_MAX_LOGIN_ATTEMPTS=5
ANALYST_LOGIN_LOCKOUT_S=300
ANALYST_SESSION_TIMEOUT_MIN=60

# --- Audit log (one JSON object per line) ---
ANALYST_AUDIT_ENABLED=true
ANALYST_AUDIT_LOG=logs/audit.jsonl
# false stores a SHA-256 of each question instead of its text
ANALYST_AUDIT_LOG_QUESTIONS=true
ANALYST_AUDIT_MAX_BYTES=10485760
ANALYST_AUDIT_BACKUPS=10

# --- Application log ---
ANALYST_LOG_LEVEL=INFO
ANALYST_LOG_FORMAT=text
